# ==========================================
# lean4-web 포트 환경설정 (.env)
# ==========================================

# 호스트 접속용 웹 포트 (기본값: 80 -> http://localhost 접속)
# 만약 맥북에서 80 포트가 이미 사용 중이라면 8000 등으로 변경하세요.
HOST_HTTP_PORT=80

# 백엔드 서버 포트 (Lean 4 Std.Http)
# 기본값: 8080
BACKEND_PORT=8080

# 프론트엔드 개발 서버 포트 (React-Vite)
# 기본값: 5173
FRONTEND_PORT=5173
